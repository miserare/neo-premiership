POSTGRES_USER=neo_premiership
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neo_premiership

# Host port for the dev database (loopback only). Off the default 5432 so it
# doesn't clash with a Postgres installed directly on your machine.
DB_HOST_PORT=55432

# Used by the backend (must use the asyncpg driver since SQLAlchemy is async here)
DATABASE_URL=postgresql+asyncpg://neo_premiership:change-me@localhost:5432/neo_premiership
CORS_ORIGINS=http://localhost:5173

# Shared secret required (via the X-Admin-Token header) to reach any admin write
# endpoint - unset means those endpoints fail closed with a 503.
ADMIN_TOKEN=change-me-admin-token

# Used by the frontend dev server (must be host-reachable, browser-side)
VITE_API_URL=http://localhost:8000

# Local development only. settings.environment defaults to "production"; setting
# this to "development" turns on SQLAlchemy query echo.
ENVIRONMENT=development

# --- Production only (docker-compose.prod.yml) ---
# The hostname Caddy requests a Let's Encrypt certificate for. Its DNS record
# must point at the server and ports 80/443 must be reachable.
DOMAIN=pokemonpremiership.com
# Leave VITE_API_URL empty in production: the frontend then calls /api on its
# own origin and Caddy routes it to the backend, so CORS never applies.
