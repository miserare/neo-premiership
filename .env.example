POSTGRES_USER=neo_premiership
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neo_premiership

# Used by the backend (must use the asyncpg driver since SQLAlchemy is async here)
DATABASE_URL=postgresql+asyncpg://neo_premiership:change-me@localhost:5432/neo_premiership
CORS_ORIGINS=http://localhost:5173

# Shared secret required (via the X-Admin-Token header) to reach any admin write
# endpoint - unset means those endpoints fail closed with a 503.
ADMIN_TOKEN=change-me-admin-token

# Used by the frontend dev server (must be host-reachable, browser-side)
VITE_API_URL=http://localhost:8000
