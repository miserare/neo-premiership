# Production configuration for pk-prem.com
#
# Copy to .env on the server, then fill in the generated secrets:
#
#     cp .env.production.example .env
#     ./scripts/generate-secrets.sh      # writes ./secrets/*, chmod 600
#
# NOTHING IN THIS FILE IS A REAL SECRET. Every placeholder below is on the
# rejection list in app/config.py, so the backend refuses to start until they
# are replaced - a half-finished deployment fails loudly instead of running
# with a guessable credential.

# ---------------------------------------------------------------- required

DOMAIN=pk-prem.com
ENVIRONMENT=production

# Empty on purpose. Caddy serves the site and proxies /api on the SAME origin,
# so the browser makes same-origin requests: no CORS, no cross-site cookies.
# Setting this to a URL would reintroduce both.
VITE_API_URL=

# ------------------------------------------------------------------ secrets
#
# These are read from files, not from this file. generate-secrets.sh creates
# them with 0600 permissions so they are not visible to other users, do not
# appear in `docker inspect`, and are not baked into any image layer.
#
#   secrets/postgres_password   - database superuser password
#   secrets/session_secret      - >=32 random bytes for session/CSRF material
#
# Compose mounts them at /run/secrets/... and the backend reads them via the
# *_FILE convention.

POSTGRES_USER=pkprem
POSTGRES_DB=pkprem

# ----------------------------------------------------------------- optional

# Legacy shared-token authentication. Superseded by administrator accounts and
# MUST stay off. Production refuses to start if this is on without a genuine
# 32+ character token.
LEGACY_ADMIN_TOKEN_ENABLED=false

# The app sits behind Caddy on the internal Docker network, so forwarded
# headers are trustworthy and needed for correct client IPs in login throttling.
TRUST_PROXY_HEADERS=true

# Swagger/ReDoc/openapi.json enumerate every admin route. Leave unset to inherit
# the production default (disabled).
# DOCS_ENABLED=false

# Session lifetime. Absolute expiry, plus an idle timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# Login throttling, enforced in the database so a restart cannot clear it.
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------------------- backups
#
# Backups are written locally and encrypted by default. To send them off-site,
# set these and see scripts/backup.sh. Leave blank until you have credentials -
# an unset destination degrades to local-only, it does not silently skip.
# BACKUP_REMOTE=            # e.g. s3://bucket/path or an rclone remote
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=6

# The IANA time zone the league's week is measured in; see README.md.
LEAGUE_TIMEZONE=America/New_York
